# TerraPilot environment. Copy to .env and fill in. Never commit .env.

# --- Runtime profile -------------------------------------------------------
# online  = Groq cloud LLMs (primary), templates as fallback
# offline = Ollama + templates only (no internet needed)
TP_PROFILE=online
TP_ENV=dev
TP_CONFIG_DIR=config
TP_DATA_DIR=data
# Optional demo clock for shift/planning views: ISO timestamp or local HH:MM today (blank = wall clock)
TP_NOW=

# --- LLM providers -----------------------------------------------------------
# Groq Cloud API key (https://console.groq.com/keys). Required for `tp llm-check`,
# `tp content`, and every online LLM task. Server-side only; never sent to the frontend.
GROQ_API_KEY=
# Ollama (offline profile / fallback). Inside docker compose use http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Database (Postgres 16 + TimescaleDB) ----------------------------------
POSTGRES_USER=terrapilot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=terrapilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://terrapilot:change-me-postgres@localhost:5432/terrapilot
# Password for the read-only `tp_ro` role used by text-to-SQL (created by migrations)
TP_RO_PASSWORD=change-me-readonly

# --- Redis / Qdrant ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- API auth ------------------------------------------------------------------
# Long random string used to sign JWTs. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-jwt-secret
CORS_ORIGINS=http://localhost:5173

# --- Optional observability (later phases) ------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
MLFLOW_TRACKING_URI=
